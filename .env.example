# Prefer: python -m verity.agents.setup --model gemini-3.5-flash-lite --save
# That writes local ignored .env.agents. This example is NOT auto-loaded.
GEMINI_API_KEY=replace_locally
VERITY_MODEL=gemini-3.5-flash-lite
# Optional PROCESS environment variable for transcription; not loaded from .env.agents.
VERITY_STT_MODEL=gemini-3.5-flash-lite
